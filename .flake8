[flake8]
# Use the standard error/style families checked by the QGIS plugin repository,
# plus local QGIS-specific rules supplied by flake8-qgis. The repository's
# enabled Flake8 rule set is server-configured and can change independently.
select = E, W, F, QGS

# QGS105: passing iface as an argument is a preference; the orchestrator stores it as documented.
# QGS201/QGS202: flagged as experimental upstream; prone to false positives.
max-line-length = 120
extend-ignore = QGS105, QGS201, QGS202

exclude =
    .git,
    __pycache__,
    build,
    release,
    .cache,
    .tmp,
    .venv-lint,
    dependencies
